{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CatalogApiEndpoint": "https+http://catalogapi",
  "OTLP_API_KEY": "AspireSampleApiKey",
  "Aspire": {
    "StackExchange": {
      "Redis": {
        "ConfigurationOptions": {
          "ConnectTimeout": 3000,
          "ConnectRetry": 2
        },
        "DisableHealthChecks": false,
        "DisableTracing": false
      }
    }
  },
  "OpenApiInfo": {
    "Title": "Web App",
    "Version": "v1",
    "Description": "Web App",
    "TermsOfService": "https://dotnet.microsoft.com/en-us/",
    "Contact": {
      "Name": "Web App",
      "Email": "",
      "Url": "https://dotnet.microsoft.com/en-us/"
    },
    "License": {
      "Name": "Use under LICX",
      "Url": "https://dotnet.microsoft.com/en-us/"
    }
  }
}
